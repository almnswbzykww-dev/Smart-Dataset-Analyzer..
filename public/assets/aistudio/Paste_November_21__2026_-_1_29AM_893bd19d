<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>نظام تحليل البيانات واستعراضها | Emerald & Platinum Desktop OS</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Cairo -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Chart.js & DataLabels Plugin -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
          },
          colors: {
            emeraldos: {
              950: '#01120c',
              900: '#032117',
              800: '#063626',
              700: '#0a4f38',
              600: '#106e4f',
              500: '#148b64',
              400: '#1ab381',
            },
            platinum: {
              100: '#f8fafc',
              200: '#e2e8f0',
              300: '#cbd5e1',
            },
            platgold: {
              100: '#fcf8e3',
              200: '#f7edbc',
              300: '#efdb8a',
              400: '#e2c974',
              500: '#c5a059',
              600: '#9b7b38',
              700: '#6d5423',
            }
          }
        }
      }
    }
  </script>

  <style>
    * {
      font-family: 'Cairo', sans-serif;
      box-sizing: border-box;
    }

    body {
      background: #010c08;
      color: #F8FAFC;
      overflow: hidden;
      user-select: none;
    }

    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #01120c;
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #148b64, #c5a059);
      border-radius: 8px;
    }

    /* Deep Obsidian Emerald Wallpaper */
    .emerald-wallpaper {
      background: 
        radial-gradient(circle at 12% 18%, rgba(20, 139, 100, 0.22) 0%, transparent 40%),
        radial-gradient(circle at 88% 82%, rgba(197, 160, 89, 0.18) 0%, transparent 45%),
        radial-gradient(circle at 50% 50%, rgba(6, 54, 38, 0.85) 0%, transparent 75%),
        linear-gradient(135deg, #010a07 0%, #031c13 50%, #01120c 100%);
    }

    /* Platinum-Gold Metallic Accents */
    .platgold-gradient {
      background: linear-gradient(135deg, #FCF8E3 0%, #E2C974 45%, #C5A059 100%);
      box-shadow: 0 4px 18px rgba(197, 160, 89, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.7);
    }
    .platgold-gradient:hover {
      background: linear-gradient(135deg, #FFFFFF 0%, #EFDB8A 50%, #D4AF37 100%);
      box-shadow: 0 6px 24px rgba(226, 201, 116, 0.45), inset 0 1px 2px rgba(255, 255, 255, 0.9);
    }

    .emerald-glow-border {
      border: 1px solid rgba(197, 160, 89, 0.35);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8), 0 0 25px rgba(20, 139, 100, 0.2);
    }

    /* Glassmorphism Panels */
    .glass-panel-emerald {
      background: linear-gradient(165deg, rgba(3, 33, 23, 0.95) 0%, rgba(1, 18, 12, 0.98) 100%);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(197, 160, 89, 0.25);
    }

    /* Tree View Styling & Branch Connectors */
    .tree-node-header {
      transition: all 0.2s ease;
    }
    .tree-node-header:hover {
      background: rgba(10, 79, 56, 0.6);
      color: #EFDB8A;
    }
    
    .tree-children {
      position: relative;
      margin-right: 0.85rem;
      padding-right: 0.65rem;
      border-right: 1.5px stroke-dasharray rgba(197, 160, 89, 0.35);
    }
    .tree-children::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 1.5px;
      background: linear-gradient(180deg, rgba(197, 160, 89, 0.4), rgba(20, 139, 100, 0.1));
    }

    .tree-item-btn {
      position: relative;
      background: rgba(1, 18, 12, 0.6);
      border: 1px solid rgba(197, 160, 89, 0.15);
      transition: all 0.18s ease;
    }
    .tree-item-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      right: -0.65rem;
      width: 0.65rem;
      height: 1px;
      background: rgba(197, 160, 89, 0.35);
    }
    .tree-item-btn:hover {
      border-color: rgba(226, 201, 116, 0.6);
      background: rgba(10, 79, 56, 0.7);
      transform: translateX(-2px);
    }
    .tree-item-btn.active-tree-item {
      background: linear-gradient(135deg, #FCF8E3 0%, #E2C974 50%, #C5A059 100%);
      color: #01120c !important;
      font-weight: 800;
      border-color: #FFF;
      box-shadow: 0 4px 14px rgba(197, 160, 89, 0.35);
    }
    .tree-item-btn.active-tree-item i,
    .tree-item-btn.active-tree-item span {
      color: #01120c !important;
    }

    /* Workspace Top Tabs */
    .workspace-tab {
      background: rgba(3, 33, 23, 0.85);
      border: 1px solid rgba(197, 160, 89, 0.25);
      color: #CBD5E1;
      transition: all 0.2s ease;
    }
    .workspace-tab:hover {
      border-color: #E2C974;
      color: #FFF;
    }
    .workspace-tab.active-tab {
      background: linear-gradient(180deg, #0A4F38 0%, #032117 100%);
      border: 1px solid #C5A059;
      border-bottom: 3px solid #E2C974;
      color: #EFDB8A;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    }

    /* Chart Canvas Surfaces */
    .chart-surface-light {
      background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
      border-radius: 12px;
      border: 2px solid #E2E8F0;
      box-shadow: inset 0 2px 4px rgba(255,255,255,0.9), 0 8px 22px rgba(0,0,0,0.4);
    }

    /* Chart Type Grid Items in Tree Panel */
    .chart-type-card-mini {
      background: rgba(1, 18, 12, 0.8);
      border: 1px solid rgba(197, 160, 89, 0.2);
      transition: all 0.18s ease;
    }
    .chart-type-card-mini:hover {
      border-color: #E2C974;
      background: rgba(10, 79, 56, 0.6);
    }
    .chart-type-card-mini.selected {
      background: linear-gradient(135deg, #C5A059 0%, #6D5423 100%);
      color: #FFFFFF;
      border-color: #FFF;
      box-shadow: 0 2px 8px rgba(197, 160, 89, 0.4);
    }

    .glow-pill-emerald {
      box-shadow: 0 0 15px rgba(20, 139, 100, 0.5);
    }
  </style>
</head>
<body class="h-screen w-screen emerald-wallpaper relative flex flex-col justify-between overflow-hidden">

  <!-- ==================== CINEMATIC LIGHT PARTICLES (SVG) ==================== -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-25 z-0" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="emGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#148b64" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#01120c" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <circle cx="18%" cy="20%" r="320" fill="url(#emGrad)" />
    <circle cx="82%" cy="80%" r="380" fill="url(#emGrad)" />
    <path d="M -100 250 Q 450 80 950 320 T 1950 120" fill="none" stroke="#c5a059" stroke-width="0.8" stroke-dasharray="6,6" opacity="0.4"/>
  </svg>

  <!-- ==================== MAIN APPLICATION WINDOW ==================== -->
  <div id="mainAppWindow" class="relative z-20 m-2 sm:m-3 mb-13 flex-1 glass-panel-emerald rounded-2xl emerald-glow-border flex flex-col overflow-hidden transition-all duration-300">
    
    <!-- Titlebar Header -->
    <div class="bg-gradient-to-r from-emeraldos-950 via-emeraldos-900 to-emeraldos-950 border-b border-platgold-500/40 px-4 py-2 flex items-center justify-between gap-3 shrink-0">
      
      <!-- Right: App Name & Logo -->
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg platgold-gradient text-emeraldos-950 flex items-center justify-center font-black text-sm shadow">
          <i class="fa-solid fa-gem"></i>
        </div>
        <div>
          <h1 class="text-xs sm:text-sm font-black text-white leading-tight">
            نظام <span class="text-platgold-400">تحليل البيانات واستعراضها</span> | Dataset Analyzer Pro
          </h1>
          <p class="text-[9.5px] text-emeraldos-400 font-bold hidden sm:block">الإصدار الزمردي الأكاديمي الشامل | Emerald Edition</p>
        </div>
      </div>

      <!-- Center: Active Dataset Badge -->
      <div class="hidden md:flex items-center gap-2 bg-emeraldos-950 px-3 py-1 rounded-xl border border-platgold-500/30">
        <i class="fa-solid fa-database text-platgold-400 text-xs"></i>
        <span id="titlebarDatasetName" class="text-xs font-black text-platgold-300" dir="ltr">بيانات_المبيعات_والأرباح.csv</span>
        <span id="titlebarDatasetBadge" class="text-[9px] bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded font-mono font-bold">CSV</span>
      </div>

      <!-- Left: Window Controls -->
      <div class="flex items-center gap-2">
        <button onclick="minimizeAppWindow()" title="تصغير إلى سطح المكتب" class="w-3.5 h-3.5 rounded-full bg-amber-400 hover:bg-amber-500 transition shadow flex items-center justify-center text-[8px] text-amber-950 font-black">
          <i class="fa-solid fa-minus opacity-0 hover:opacity-100"></i>
        </button>
        <button onclick="toggleMaximizeWindow()" title="استعادة / مليان الشاشة" class="w-3.5 h-3.5 rounded-full bg-emerald-500 hover:bg-emerald-600 transition shadow flex items-center justify-center text-[8px] text-emerald-950 font-black">
          <i class="fa-solid fa-expand opacity-0 hover:opacity-100"></i>
        </button>
        <button onclick="closeAppWindow()" title="إغلاق" class="w-3.5 h-3.5 rounded-full bg-rose-500 hover:bg-rose-600 transition shadow flex items-center justify-center text-[8px] text-rose-950 font-black">
          <i class="fa-solid fa-xmark opacity-0 hover:opacity-100"></i>
        </button>
      </div>
    </div>

    <!-- Window Inner Content (2-Column: Compact Right Tree Panel (265px) | Left Main Workspace) -->
    <div class="flex-1 flex overflow-hidden">
      
      <!-- ==================== COMPACT RIGHT-SIDE TREE-VIEW PANEL (265px) ==================== -->
      <aside class="w-[265px] shrink-0 bg-emeraldos-950/95 border-l border-platgold-500/30 p-2.5 flex flex-col justify-between overflow-y-auto gap-2.5 shadow-2xl z-10 text-xs">
        
        <div class="space-y-2">
          
          <!-- TREE HEADER -->
          <div class="flex items-center justify-between border-b border-platgold-500/25 pb-1.5 px-1">
            <div class="flex items-center gap-1.5">
              <i class="fa-solid fa-sitemap text-platgold-400 text-xs"></i>
              <h3 class="text-xs font-black text-white">لوحة التحكم الشجرية</h3>
            </div>
            <span class="text-[9px] bg-emeraldos-800 text-platgold-300 px-1.5 py-0.5 rounded font-bold">Tree-View</span>
          </div>

          <!-- TREE HIERARCHY ROOT -->
          <div class="space-y-1.5 font-bold" id="treeViewRoot">
            
            <!-- NODE 1: PAGES EXPLORER -->
            <div class="tree-node">
              <div onclick="toggleTreeNode('treeNodePages')" class="tree-node-header flex items-center justify-between p-1.5 rounded-lg cursor-pointer text-platgold-300">
                <div class="flex items-center gap-1.5">
                  <i id="treeNodePagesArrow" class="fa-solid fa-chevron-down text-[10px] text-platgold-400 transition-transform"></i>
                  <i class="fa-solid fa-folder-open text-amber-400 text-xs"></i>
                  <span class="text-xs font-black">1. مستكشف الصفحات</span>
                </div>
                <span class="text-[9px] text-slate-400">6</span>
              </div>

              <!-- Children of Node 1 -->
              <div id="treeNodePages" class="tree-children mt-1 space-y-1">
                
                <button onclick="openOrSwitchTab('dashboard')" data-tree-page="dashboard" class="tree-item-btn active-tree-item w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-house text-emerald-400 text-xs"></i>
                    <span>لوحة القيادة</span>
                  </div>
                  <i class="fa-solid fa-angle-left text-[9px] opacity-60"></i>
                </button>

                <button onclick="openOrSwitchTab('studio')" data-tree-page="studio" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-chart-column text-emerald-400 text-xs"></i>
                    <span>استوديو الرسوم</span>
                  </div>
                  <i class="fa-solid fa-angle-left text-[9px] opacity-60"></i>
                </button>

                <button onclick="openOrSwitchTab('stats')" data-tree-page="stats" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-calculator text-emerald-400 text-xs"></i>
                    <span>التحليل الإحصائي</span>
                  </div>
                  <i class="fa-solid fa-angle-left text-[9px] opacity-60"></i>
                </button>

                <button onclick="openOrSwitchTab('details')" data-tree-page="details" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-table-list text-emerald-400 text-xs"></i>
                    <span>مستعرض البيانات</span>
                  </div>
                  <i class="fa-solid fa-angle-left text-[9px] opacity-60"></i>
                </button>

                <button onclick="openOrSwitchTab('loader')" data-tree-page="loader" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-folder-open text-emerald-400 text-xs"></i>
                    <span>استيراد ملف</span>
                  </div>
                  <i class="fa-solid fa-angle-left text-[9px] opacity-60"></i>
                </button>

                <button onclick="openOrSwitchTab('about')" data-tree-page="about" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-graduation-cap text-emerald-400 text-xs"></i>
                    <span>الدليل الأكاديمي</span>
                  </div>
                  <i class="fa-solid fa-angle-left text-[9px] opacity-60"></i>
                </button>

              </div>
            </div>

            <!-- NODE 2: DATA SOURCES -->
            <div class="tree-node pt-1">
              <div onclick="toggleTreeNode('treeNodeData')" class="tree-node-header flex items-center justify-between p-1.5 rounded-lg cursor-pointer text-platgold-300">
                <div class="flex items-center gap-1.5">
                  <i id="treeNodeDataArrow" class="fa-solid fa-chevron-down text-[10px] text-platgold-400 transition-transform"></i>
                  <i class="fa-solid fa-database text-sky-400 text-xs"></i>
                  <span class="text-xs font-black">2. إدارة البيانات</span>
                </div>
                <span class="text-[9px] text-slate-400">4</span>
              </div>

              <!-- Children of Node 2 -->
              <div id="treeNodeData" class="tree-children mt-1 space-y-1">
                <button onclick="switchDataset('sales')" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-basket-shopping text-amber-400 text-[10px]"></i>
                    <span class="truncate">مبيعات المتجر (CSV)</span>
                  </div>
                  <span class="text-[8px] bg-emerald-500/20 text-emerald-300 px-1 rounded">1k</span>
                </button>

                <button onclick="switchDataset('employees')" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-users text-sky-400 text-[10px]"></i>
                    <span class="truncate">بيانات الموظفين (CSV)</span>
                  </div>
                  <span class="text-[8px] bg-sky-500/20 text-sky-300 px-1 rounded">850</span>
                </button>

                <button onclick="switchDataset('students')" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-user-graduate text-purple-400 text-[10px]"></i>
                    <span class="truncate">درجات الطلاب (JSON)</span>
                  </div>
                  <span class="text-[8px] bg-purple-500/20 text-purple-300 px-1 rounded">620</span>
                </button>

                <button onclick="openOrSwitchTab('loader')" class="tree-item-btn w-full p-1.5 rounded-lg flex items-center justify-between text-white">
                  <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-file-circle-plus text-emerald-400 text-[10px]"></i>
                    <span class="truncate">رفع ملف خارجي...</span>
                  </div>
                </button>
              </div>
            </div>

            <!-- NODE 3: CHART CONTROLS & AXES -->
            <div class="tree-node pt-1">
              <div onclick="toggleTreeNode('treeNodeControls')" class="tree-node-header flex items-center justify-between p-1.5 rounded-lg cursor-pointer text-platgold-300">
                <div class="flex items-center gap-1.5">
                  <i id="treeNodeControlsArrow" class="fa-solid fa-chevron-down text-[10px] text-platgold-400 transition-transform"></i>
                  <i class="fa-solid fa-sliders text-platgold-400 text-xs"></i>
                  <span class="text-xs font-black">3. إعدادات المحاور</span>
                </div>
              </div>

              <!-- Children of Node 3 -->
              <div id="treeNodeControls" class="tree-children mt-1 p-2 bg-emeraldos-900/90 rounded-xl border border-platgold-500/20 space-y-2">
                
                <!-- X Select -->
                <div>
                  <label class="block text-[10px] font-bold text-slate-300 mb-0.5">المحور الأفقي (X):</label>
                  <select id="ctrlXSelect" onchange="executeGenerateChart()" class="w-full bg-emeraldos-950 text-white font-bold text-[11px] rounded p-1 border border-platgold-500/30 focus:outline-none"></select>
                </div>

                <!-- Y Select -->
                <div>
                  <label class="block text-[10px] font-bold text-slate-300 mb-0.5">المحور الرأسي (Y):</label>
                  <select id="ctrlYSelect" onchange="executeGenerateChart()" class="w-full bg-emeraldos-950 text-white font-bold text-[11px] rounded p-1 border border-platgold-500/30 focus:outline-none"></select>
                </div>

                <!-- Aggregation Mode -->
                <div>
                  <label class="block text-[10px] font-bold text-slate-300 mb-0.5">التجميع (Aggregation):</label>
                  <select id="ctrlAggSelect" onchange="executeGenerateChart()" class="w-full bg-emeraldos-950 text-white font-bold text-[11px] rounded p-1 border border-platgold-500/30 focus:outline-none">
                    <option value="sum" selected>المجموع (Sum)</option>
                    <option value="avg">المتوسط (Average)</option>
                    <option value="count">العدد (Count)</option>
                    <option value="max">أعلى قيمة (Max)</option>
                    <option value="min">أدنى قيمة (Min)</option>
                  </select>
                </div>

                <!-- 2x3 Chart Type Grid -->
                <div>
                  <label class="block text-[10px] font-bold text-slate-300 mb-1">نوع الرسم البياني:</label>
                  <div class="grid grid-cols-3 gap-1" id="chartTypeGrid">
                    <button onclick="selectChartType('bar')" data-type="bar" class="chart-type-card-mini selected p-1 rounded text-center flex flex-col items-center justify-center">
                      <i class="fa-solid fa-chart-column text-xs"></i>
                      <span class="text-[9px] font-bold">أعمدة</span>
                    </button>
                    <button onclick="selectChartType('line')" data-type="line" class="chart-type-card-mini p-1 rounded text-center flex flex-col items-center justify-center">
                      <i class="fa-solid fa-chart-line text-xs"></i>
                      <span class="text-[9px] font-bold">خطي</span>
                    </button>
                    <button onclick="selectChartType('pie')" data-type="pie" class="chart-type-card-mini p-1 rounded text-center flex flex-col items-center justify-center">
                      <i class="fa-solid fa-chart-pie text-xs"></i>
                      <span class="text-[9px] font-bold">دائري</span>
                    </button>
                    <button onclick="selectChartType('doughnut')" data-type="doughnut" class="chart-type-card-mini p-1 rounded text-center flex flex-col items-center justify-center">
                      <i class="fa-solid fa-circle-notch text-xs"></i>
                      <span class="text-[9px] font-bold">حلقي</span>
                    </button>
                    <button onclick="selectChartType('radar')" data-type="radar" class="chart-type-card-mini p-1 rounded text-center flex flex-col items-center justify-center">
                      <i class="fa-solid fa-satellite-dish text-xs"></i>
                      <span class="text-[9px] font-bold">رادار</span>
                    </button>
                    <button onclick="selectChartType('polarArea')" data-type="polarArea" class="chart-type-card-mini p-1 rounded text-center flex flex-col items-center justify-center">
                      <i class="fa-solid fa-compass text-xs"></i>
                      <span class="text-[9px] font-bold">قطبي</span>
                    </button>
                  </div>
                </div>

                <!-- Execute Button -->
                <button onclick="executeGenerateChart(true)" class="w-full platgold-gradient text-emeraldos-950 font-black text-xs py-2 rounded-lg shadow flex items-center justify-center gap-1.5 mt-1">
                  <i class="fa-solid fa-play text-[10px]"></i>
                  <span>تنفيذ وعرض النتائج ▶</span>
                </button>
              </div>
            </div>

            <!-- NODE 4: EXPORT & SAVE -->
            <div class="tree-node pt-1">
              <div onclick="toggleTreeNode('treeNodeExport')" class="tree-node-header flex items-center justify-between p-1.5 rounded-lg cursor-pointer text-platgold-300">
                <div class="flex items-center gap-1.5">
                  <i id="treeNodeExportArrow" class="fa-solid fa-chevron-down text-[10px] text-platgold-400 transition-transform"></i>
                  <i class="fa-solid fa-download text-emerald-400 text-xs"></i>
                  <span class="text-xs font-black">4. التصدير والحفظ</span>
                </div>
              </div>

