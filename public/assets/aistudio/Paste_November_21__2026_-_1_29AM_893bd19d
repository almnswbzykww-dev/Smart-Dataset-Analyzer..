    <i id="toastIcon" class="fa-solid fa-circle-check text-platgold-400"></i>
    <span id="toastMsg">تم تنفيذ العملية بنجاح</span>
  </div>

  <!-- ==================== JAVASCRIPT LOGIC ==================== -->
  <script>
    Chart.register(ChartDataLabels);

    const datasets = {
      sales: {
        id: 'sales',
        name: 'بيانات_المبيعات_والأرباح.csv',
        rowsCount: 1000,
        colsCount: 8,
        columns: ['#', 'الفرع', 'الفئة', 'المبيعات', 'الأرباح', 'الربع', 'المسؤول', 'الحالة'],
        numericCols: ['المبيعات', 'الأرباح'],
        catCols: ['الفرع', 'الفئة', 'الربع', 'الحالة'],
        defaultX: 'الفرع',
        defaultY: 'المبيعات',
        rows: [
          { '#': 1, 'الفرع': 'صنعاء الرئيسي', 'الفئة': 'المنتجات الرقمية', 'المبيعات': 1250000, 'الأرباح': 350000, 'الربع': 'Q1', 'المسؤول': 'أحمد العزعزي', 'الحالة': 'مكتمل' },
          { '#': 2, 'الفرع': 'عدن التجاري', 'الفئة': 'الأجهزة الالكترونية', 'المبيعات': 980000, 'الأرباح': 240000, 'الربع': 'Q1', 'المسؤول': 'سارة محمد', 'الحالة': 'مكتمل' },
          { '#': 3, 'الفرع': 'تعز المركزي', 'الفئة': 'خدمات البرمجيات', 'المبيعات': 750000, 'الأرباح': 310000, 'الربع': 'Q2', 'المسؤول': 'عمر حسن', 'الحالة': 'مكتمل' },
          { '#': 4, 'الفرع': 'حضرموت', 'الفئة': 'المنتجات الرقمية', 'المبيعات': 1100000, 'الأرباح': 400000, 'الربع': 'Q2', 'المسؤول': 'خالد سالم', 'الحالة': 'مكتمل' },
          { '#': 5, 'الفرع': 'إب', 'الفئة': 'الأجهزة الالكترونية', 'المبيعات': 620000, 'الأرباح': 150000, 'الربع': 'Q3', 'المسؤول': 'فاطمة علي', 'الحالة': 'قيد التنفيذ' }
        ]
      },
      employees: {
        id: 'employees',
        name: 'بيانات_الموظفين_والرواتب.csv',
        rowsCount: 850,
        colsCount: 8,
        columns: ['#', 'اسم الموظف', 'القسم', 'الراتب', 'العمر', 'الجنس', 'سنوات الخبرة', 'التقييم'],
        numericCols: ['الراتب', 'العمر', 'سنوات الخبرة'],
        catCols: ['القسم', 'الجنس', 'التقييم'],
        defaultX: 'القسم',
        defaultY: 'الراتب',
        rows: [
          { '#': 1, 'اسم الموظف': 'زكريا فيصل العزعزي', 'القسم': 'تقنية المعلومات', 'الراتب': 850000, 'العمر': 28, 'الجنس': 'ذكر', 'سنوات الخبرة': 6, 'التقييم': 'ممتاز' },
          { '#': 2, 'اسم الموظف': 'مريم أحمد', 'القسم': 'المالية', 'الراتب': 620000, 'العمر': 32, 'الجنس': 'أنثى', 'سنوات الخبرة': 7, 'التقييم': 'جيد جداً' },
          { '#': 3, 'اسم الموظف': 'عبدالرحمن علي', 'القسم': 'المبيعات', 'الراتب': 540000, 'العمر': 29, 'الجنس': 'ذكر', 'سنوات الخبرة': 4, 'التقييم': 'ممتاز' }
        ]
      },
      students: {
        id: 'students',
        name: 'نتائج_درجات_الطلاب.json',
        rowsCount: 620,
        colsCount: 7,
        columns: ['#', 'اسم الطالب', 'التخصص', 'المعدل', 'الساعات', 'التقدير', 'المدينة'],
        numericCols: ['المعدل', 'الساعات'],
        catCols: ['التخصص', 'التقدير', 'المدينة'],
        defaultX: 'التخصص',
        defaultY: 'المعدل',
        rows: [
          { '#': 1, 'اسم الطالب': 'ياسر فؤاد', 'التخصص': 'علوم الحاسوب', 'المعدل': 94, 'الساعات': 134, 'التقدير': 'امتياز', 'المدينة': 'صنعاء' },
          { '#': 2, 'اسم الطالب': 'آلاء حسن', 'التخصص': 'ذكاء اصطناعي', 'المعدل': 91, 'الساعات': 128, 'التقدير': 'امتياز', 'المدينة': 'تعز' }
        ]
      }
    };

    let activeDataset = datasets.sales;
    let activeTabs = ['dashboard', 'studio'];
    let currentActiveTab = 'dashboard';
    let selectedChartType = 'bar';

    let dashMainChartInstance = null;
    let dashDonutChartInstance = null;
    let studioChartInstance = null;

    const emeraldPalette = ['#106e4f', '#148b64', '#c5a059', '#10B981', '#06B6D4', '#F59E0B'];

    const pageTitles = {
      dashboard: { title: 'لوحة القيادة', icon: 'fa-house' },
      studio: { title: 'استوديو الرسوم', icon: 'fa-chart-column' },
      stats: { title: 'التحليل الإحصائي', icon: 'fa-calculator' },
      details: { title: 'مستعرض البيانات', icon: 'fa-table-list' },
      loader: { title: 'استيراد ملف', icon: 'fa-folder-open' },
      about: { title: 'الدليل الأكاديمي', icon: 'fa-graduation-cap' }
    };

    window.addEventListener('DOMContentLoaded', () => {
      startClock();
      renderTabs();
      applyDatasetToUI();
    });

    function startClock() {
      setInterval(() => {
        const now = new Date();
        document.getElementById('osClock').textContent = now.toLocaleTimeString('ar-YE');
      }, 1000);
    }

    // TREE COLLAPSE TOGGLE
    function toggleTreeNode(nodeId) {
      const el = document.getElementById(nodeId);
      const arrow = document.getElementById(nodeId + 'Arrow');
      if (el) {
        el.classList.toggle('hidden');
        if (arrow) arrow.classList.toggle('rotate-180');
      }
    }

    // TAB SYSTEM
    function renderTabs() {
      const container = document.getElementById('tabList');
      container.innerHTML = activeTabs.map(pageId => {
        const info = pageTitles[pageId];
        const isActive = pageId === currentActiveTab;
        return `
          <div class="workspace-tab px-2.5 py-1 rounded-lg text-xs flex items-center gap-1.5 cursor-pointer ${isActive ? 'active-tab' : ''}" onclick="switchTab('${pageId}')">
            <i class="fa-solid ${info.icon}"></i>
            <span>${info.title}</span>
            ${activeTabs.length > 1 ? `<i class="fa-solid fa-xmark hover:text-rose-400 p-0.5" onclick="event.stopPropagation(); closeTab('${pageId}')"></i>` : ''}
          </div>
        `;
      }).join('');
    }

    function openOrSwitchTab(pageId) {
      if (!activeTabs.includes(pageId)) activeTabs.push(pageId);
      switchTab(pageId);
    }

    function switchTab(pageId) {
      currentActiveTab = pageId;
      renderTabs();

      document.querySelectorAll('.page-view').forEach(p => p.classList.add('hidden'));
      const target = document.getElementById(`page-${pageId}`);
      if (target) target.classList.remove('hidden');

      // Highlight active item in Tree View
      document.querySelectorAll('#treeViewRoot .tree-item-btn').forEach(btn => {
        btn.classList.remove('active-tree-item');
        if (btn.dataset.treePage === pageId) btn.classList.add('active-tree-item');
      });

      if (pageId === 'studio') renderStudioCanvas();
    }

    function closeTab(pageId) {
      activeTabs = activeTabs.filter(id => id !== pageId);
      if (currentActiveTab === pageId) currentActiveTab = activeTabs[activeTabs.length - 1] || 'dashboard';
      renderTabs();
      switchTab(currentActiveTab);
    }

    function selectChartType(type) {
      selectedChartType = type;
      document.querySelectorAll('#chartTypeGrid .chart-type-card-mini').forEach(btn => {
        btn.classList.remove('selected');
        if (btn.dataset.type === type) btn.classList.add('selected');
      });
      executeGenerateChart();
    }

    function switchDataset(key) {
      if (datasets[key]) {
        activeDataset = datasets[key];
        applyDatasetToUI();
        showToast(`تم تحميل البيانات: ${activeDataset.name}`);
      }
    }

    function applyDatasetToUI() {
      document.getElementById('titlebarDatasetName').textContent = activeDataset.name;
      document.getElementById('titlebarDatasetBadge').textContent = activeDataset.name.endsWith('.json') ? 'JSON' : 'CSV';

      const xSel = document.getElementById('ctrlXSelect');
      const ySel = document.getElementById('ctrlYSelect');
      xSel.innerHTML = activeDataset.catCols.map(c => `<option value="${c}">${c}</option>`).join('');
      ySel.innerHTML = activeDataset.numericCols.map(c => `<option value="${c}">${c}</option>`).join('');

      const detailsCatSel = document.getElementById('detailsCatFilter');
      const firstCat = activeDataset.catCols[0];
      detailsCatSel.innerHTML = `<option value="ALL">جميع السجلات (${activeDataset.rows.length})</option>`;
      if (firstCat) {
        const uniques = [...new Set(activeDataset.rows.map(r => r[firstCat]))];
        uniques.forEach(u => detailsCatSel.innerHTML += `<option value="${u}">${firstCat}: ${u}</option>`);
      }

      renderFullDetailsGrid();
      renderStatsMatrix();
      renderDashCharts();
    }

    function aggregateData(xCol, yCol, mode = 'sum') {
      const groups = {}, counts = {}, maxs = {}, mins = {};

      activeDataset.rows.forEach(r => {
        const key = String(r[xCol] || 'غير محدد');
        const val = parseFloat(r[yCol]) || 0;

        groups[key] = (groups[key] || 0) + val;
        counts[key] = (counts[key] || 0) + 1;
        maxs[key] = maxs[key] !== undefined ? Math.max(maxs[key], val) : val;
        mins[key] = mins[key] !== undefined ? Math.min(mins[key], val) : val;
      });

      const labels = Object.keys(groups);
      const values = labels.map(k => {
        if (mode === 'sum') return groups[k];
        if (mode === 'count') return counts[k];
        if (mode === 'max') return maxs[k];
        if (mode === 'min') return mins[k];
        return Math.round(groups[k] / counts[k]);
      });

      return { labels, values };
    }

    function renderDashCharts() {
      const xCol = document.getElementById('ctrlXSelect').value || activeDataset.defaultX;
      const yCol = document.getElementById('ctrlYSelect').value || activeDataset.defaultY;
      const mode = document.getElementById('ctrlAggSelect').value || 'sum';

      const { labels, values } = aggregateData(xCol, yCol, mode);

      const totalSum = values.reduce((a, b) => a + b, 0);
      const avgVal = values.length ? Math.round(totalSum / values.length) : 0;
      const maxVal = values.length ? Math.max(...values) : 0;
      const minVal = values.length ? Math.min(...values) : 0;

      const maxIdx = values.indexOf(maxVal);
      const minIdx = values.indexOf(minVal);

      document.getElementById('kpiTotalSum').textContent = totalSum.toLocaleString();
      document.getElementById('kpiAverageVal').textContent = avgVal.toLocaleString();
      document.getElementById('kpiMaxVal').textContent = maxVal.toLocaleString();
      document.getElementById('kpiMaxCategory').textContent = labels[maxIdx] ? `الأعلى: ${labels[maxIdx]}` : '';
      document.getElementById('kpiMinVal').textContent = minVal.toLocaleString();
      document.getElementById('kpiMinCategory').textContent = labels[minIdx] ? `الأدنى: ${labels[minIdx]}` : '';

      document.getElementById('kpiRowsCount').textContent = activeDataset.rowsCount.toLocaleString();
      document.getElementById('kpiColsCount').textContent = activeDataset.colsCount;

      document.getElementById('dashBarTitle').textContent = `نتائج ${yCol} حسب ${xCol} (${mode.toUpperCase()})`;

      const ctxMain = document.getElementById('dashMainCanvas').getContext('2d');
      if (dashMainChartInstance) dashMainChartInstance.destroy();

      dashMainChartInstance = new Chart(ctxMain, {
        type: selectedChartType,
        data: {
          labels: labels,
          datasets: [{
            label: yCol,
            data: values,
            backgroundColor: emeraldPalette,
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { color: '#01120c', font: { family: 'Cairo', weight: 'bold', size: 10 } } },
            datalabels: {
              color: ['pie', 'doughnut'].includes(selectedChartType) ? '#FFF' : '#01120c',
              anchor: 'end',
              align: 'top',
              font: { family: 'Cairo', weight: '800', size: 9 },
              formatter: (v) => v.toLocaleString()
            }
          }
        }
      });

      const ctxDonut = document.getElementById('dashDonutCanvas').getContext('2d');
      if (dashDonutChartInstance) dashDonutChartInstance.destroy();

      dashDonutChartInstance = new Chart(ctxDonut, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{ data: values, backgroundColor: emeraldPalette, borderWidth: 2 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '55%',
          plugins: {
            legend: { position: 'bottom', labels: { color: '#01120c', font: { family: 'Cairo', weight: '700', size: 9 } } },
            datalabels: { display: false }
          }
        }
      });

      renderBreakdownTable(labels, values, totalSum, avgVal);
    }

    function renderBreakdownTable(labels, values, totalSum, avgVal) {
      const tbody = document.getElementById('dashBreakdownBody');
      const items = labels.map((l, i) => ({
        label: l,
        val: values[i],
        pct: totalSum ? ((values[i] / totalSum) * 100).toFixed(1) : 0,
        diff: values[i] - avgVal
      })).sort((a, b) => b.val - a.val);

      tbody.innerHTML = items.map((item, idx) => `
        <tr class="hover:bg-emeraldos-800/80 transition">
          <td class="py-1.5 px-3 font-bold text-platgold-400">#${idx + 1}</td>
          <td class="py-1.5 px-3 font-bold text-white">${item.label}</td>
          <td class="py-1.5 px-3 font-black text-emerald-400">${item.val.toLocaleString()}</td>
          <td class="py-1.5 px-3">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-200 w-10">${item.pct}%</span>
              <div class="flex-1 bg-emeraldos-950 rounded-full h-1.5 overflow-hidden border border-white/10">
                <div class="platgold-gradient h-full rounded-full" style="width: ${Math.min(item.pct, 100)}%"></div>
              </div>
            </div>
          </td>
          <td class="py-1.5 px-3 font-bold ${item.diff >= 0 ? 'text-emerald-400' : 'text-rose-400'}">
            ${item.diff >= 0 ? '+' : ''}${item.diff.toLocaleString()}
          </td>
        </tr>
      `).join('');
    }

    function renderStudioCanvas() {
      const xCol = document.getElementById('ctrlXSelect').value || activeDataset.defaultX;
      const yCol = document.getElementById('ctrlYSelect').value || activeDataset.defaultY;
      const mode = document.getElementById('ctrlAggSelect').value || 'sum';

      const { labels, values } = aggregateData(xCol, yCol, mode);
      const title = `عرض مكبر: ${mode.toUpperCase()} (${yCol}) حسب (${xCol})`;
      document.getElementById('studioHeaderTitle').textContent = title;

      const ctx = document.getElementById('studioCanvas').getContext('2d');
      if (studioChartInstance) studioChartInstance.destroy();

      studioChartInstance = new Chart(ctx, {
        type: selectedChartType,
        data: {
          labels: labels,
          datasets: [{ label: title, data: values, backgroundColor: emeraldPalette, borderRadius: 6 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { color: '#01120c', font: { family: 'Cairo', weight: 'bold' } } },
            datalabels: {
              color: ['pie', 'doughnut'].includes(selectedChartType) ? '#FFF' : '#01120c',
              font: { family: 'Cairo', weight: '800', size: 10 },
              formatter: (v) => v.toLocaleString()
            }
          }
        }
      });
    }

    function executeGenerateChart(notify = false) {
      renderDashCharts();
      if (currentActiveTab === 'studio') renderStudioCanvas();
      if (notify) showToast('تم تحديث الرسوم والنتائج بنجاح!');
    }

    function renderFullDetailsGrid() {
      const head = document.getElementById('fullDetailsHead');
      const body = document.getElementById('fullDetailsBody');
      const cols = activeDataset.columns;

      const search = document.getElementById('detailsSearchField').value.trim().toLowerCase();
      const catVal = document.getElementById('detailsCatFilter').value;
      const firstCat = activeDataset.catCols[0];

      head.innerHTML = cols.map(c => `<th class="py-1.5 px-3 font-black whitespace-nowrap">${c}</th>`).join('');

      const filtered = activeDataset.rows.filter(r => {
        const matchCat = catVal === 'ALL' || (firstCat && String(r[firstCat]) === catVal);
        const matchSearch = !search || Object.values(r).some(v => String(v).toLowerCase().includes(search));
        return matchCat && matchSearch;
      });

      body.innerHTML = filtered.map(r => `
        <tr onclick='openInspectorModal(${JSON.stringify(r)})' class="hover:bg-emeraldos-800/80 cursor-pointer transition">
          ${cols.map(c => `<td class="py-1.5 px-3 whitespace-nowrap text-slate-100">${r[c]}</td>`).join('')}
        </tr>
      `).join('');
    }

    function renderStatsMatrix() {
      const container = document.getElementById('statsMatrixGrid');
      container.innerHTML = activeDataset.numericCols.map(col => {
        const vals = activeDataset.rows.map(r => parseFloat(r[col])).filter(n => !isNaN(n)).sort((a,b)=>a-b);
        const sum = vals.reduce((a,b)=>a+b,0);
        const mean = (sum / vals.length).toFixed(1);
        const min = vals[0];
        const max = vals[vals.length - 1];
        const median = vals[Math.floor(vals.length / 2)];

        return `
          <div class="bg-emeraldos-950/90 border border-platgold-500/30 rounded-xl p-2.5">
            <div class="flex items-center justify-between border-b border-white/10 pb-1 mb-1.5">
              <h3 class="text-xs font-black text-platgold-400">إحصائيات العموم: ${col}</h3>
              <span class="text-[9px] bg-sky-500/20 text-sky-300 px-1.5 py-0.5 rounded font-mono">df['${col}'].describe()</span>
            </div>
            <div class="grid grid-cols-3 gap-1 text-center text-xs">
              <div class="bg-emeraldos-900 p-1 rounded border border-white/10">
                <p class="text-[8.5px] text-slate-400">المتوسط Mean</p>
                <p class="text-xs font-black text-white mt-0.5">${Number(mean).toLocaleString()}</p>
              </div>
              <div class="bg-emeraldos-900 p-1 rounded border border-white/10">
                <p class="text-[8.5px] text-slate-400">الوسيط Median</p>
                <p class="text-xs font-black text-emerald-400 mt-0.5">${Number(median).toLocaleString()}</p>
              </div>
              <div class="bg-emeraldos-900 p-1 rounded border border-white/10">
                <p class="text-[8.5px] text-slate-400">الأقصى Max</p>
                <p class="text-xs font-black text-sky-400 mt-0.5">${Number(max).toLocaleString()}</p>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function handleRealFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const text = e.target.result;
          let parsedRows = [];
          if (file.name.endsWith('.json')) {
            const json = JSON.parse(text);
            parsedRows = Array.isArray(json) ? json : (json.data || []);
          } else {
            const lines = text.split(/\r?\n/).filter(l => l.trim() !== '');
            const headers = lines[0].split(',').map(h => h.trim().replace(/^"|"$/g, ''));
            parsedRows = lines.slice(1).map((line, i) => {
              const vals = line.split(',').map(v => v.trim().replace(/^"|"$/g, ''));
              const obj = { '#': i + 1 };
              headers.forEach((h, idx) => {
                const num = Number(vals[idx]);
                obj[h] = !isNaN(num) && vals[idx] !== '' ? num : (vals[idx] || '');
              });
              return obj;
            });
          }

          if (parsedRows.length === 0) return showToast('الملف فارغ أو غير صالح', 'error');

          const cols = Object.keys(parsedRows[0]);
          const numCols = cols.filter(c => c !== '#' && typeof parsedRows[0][c] === 'number');
          const catCols = cols.filter(c => c !== '#' && typeof parsedRows[0][c] !== 'number');

          activeDataset = {
            id: 'custom',
            name: file.name,
            rowsCount: parsedRows.length,
            colsCount: cols.length,
            columns: cols,
            numericCols: numCols.length ? numCols : [cols[cols.length - 1]],
            catCols: catCols.length ? catCols : [cols[0]],
            defaultX: catCols[0] || cols[0],
            defaultY: numCols[0] || cols[1] || cols[0],
            rows: parsedRows
          };

          applyDatasetToUI();
          openOrSwitchTab('dashboard');
          showToast(`تم استيراد الملف "${file.name}" بنجاح!`);
        } catch (err) {
          showToast('حدث خطأ أثناء قراءة الملف.', 'error');
        }
      };
      reader.readAsText(file);
    }

    function closeAppWindow() {
      const win = document.getElementById('mainAppWindow');
      win.classList.add('scale-95', 'opacity-0');
      setTimeout(() => win.classList.add('hidden'), 200);
      document.getElementById('taskbarAppItem').classList.remove('glow-pill-emerald');
    }

    function minimizeAppWindow() {
      const win = document.getElementById('mainAppWindow');
      win.classList.add('translate-y-full', 'opacity-0');
      setTimeout(() => win.classList.add('hidden'), 200);
      document.getElementById('taskbarAppItem').classList.remove('glow-pill-emerald');
    }

    function restoreAppWindow() {
      const win = document.getElementById('mainAppWindow');
      win.classList.remove('hidden', 'translate-y-full', 'scale-95', 'opacity-0');
      document.getElementById('taskbarAppItem').classList.add('glow-pill-emerald');
    }

    function toggleMaximizeWindow() {
      const win = document.getElementById('mainAppWindow');
      win.classList.toggle('m-0');
      win.classList.toggle('rounded-none');
    }

    function toggleStartMenu() {
      document.getElementById('startMenu').classList.toggle('hidden');
    }

    function downloadChartCanvas() {
      const canvas = currentActiveTab === 'studio' ? document.getElementById('studioCanvas') : document.getElementById('dashMainCanvas');
      if (!canvas) return;
      const a = document.createElement('a');
      a.download = `Chart_${activeDataset.name.split('.')[0]}.png`;
      a.href = canvas.toDataURL('image/png', 1.0);
      a.click();
      showToast('تم حفظ صورة الرسم البياني PNG!');
    }

    function exportCSVFile() {
      const cols = activeDataset.columns;
      const csvContent = [
        cols.join(','),
        ...activeDataset.rows.map(r => cols.map(c => `"${r[c]}"`).join(','))
      ].join('\n');

      const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `Exported_${activeDataset.name.split('.')[0]}.csv`;
      a.click();
      showToast('تم تصدير ملف CSV بنجاح!');
    }

    function openInspectorModal(rowObj) {
      const modal = document.getElementById('inspectorModal');
      const content = document.getElementById('inspectorContent');
      content.innerHTML = Object.entries(rowObj).map(([k, v]) => `
        <div class="flex items-center justify-between bg-emeraldos-950 px-2.5 py-1 rounded border border-white/10">
          <span class="font-bold text-platgold-300">${k}:</span>
          <span class="font-bold text-white">${v}</span>
        </div>
      `).join('');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeInspectorModal() {
      const modal = document.getElementById('inspectorModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      const icon = document.getElementById('toastIcon');
      document.getElementById('toastMsg').textContent = msg;

      icon.className = type === 'error'
        ? 'fa-solid fa-triangle-exclamation text-rose-400'
        : 'fa-solid fa-circle-check text-platgold-400';

      toast.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => toast.classList.add('translate-y-24', 'opacity-0'), 2400);
    }
  </script>
</body>
</html>